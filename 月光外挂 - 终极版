function zstx()
    threadpool:work(function()
        if not ClientCurGame or not ClientCurGame:isInGame() then
            ShowGameTipsWithoutFilter("#cFF7aadHãy vào phòng trước")
            return
        end

        local uin = AccountManager:getUin()
        if not uin then
            ShowGameTipsWithoutFilter("#cff0000Không lấy được UIN người chơi")
            return
        end

        is_zstx_active = not is_zstx_active
        if is_zstx_active then
            local count = 0
            for i = 1, #commonNameList do
                local tdata = {
                    [1] = "actor",
                    [2] = "playBodyEffectByFile",
                    [3] = { uin, commonNameList[i], true }
