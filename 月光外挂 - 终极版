function SystemMessageInput()

    -- FIRST INPUT: MESSAGE
    ShowGameTipsWithoutFilter("#GSelect a message")

    ShowTextInputSafe(function(message)

        if not message or message == "" then
            ShowGameTipsWithoutFilter("#cFF4444Message cannot be empty")
            return
        end

        -- SECOND INPUT: COLOUR
        ShowGameTipsWithoutFilter("#YSelect a colour")

        ShowTextInputSafe(function(colour)

            if not colour or colour == "" then
                ShowGameTipsWithoutFilter("#cFF4444Colour cannot be empty")
                return
            end

            -- The colour must include its own #
            if string.sub(colour, 1, 1) ~= "#" then
                ShowGameTipsWithoutFilter("#cFF4444Colour must start with #")
                return
            end

            -- BUILD FINAL MESSAGE
            local finalMessage =
