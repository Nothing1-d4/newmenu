                                                        )
                                                        b = math.floor(
                                                            255 * t
                                                        )

                                                    else

                                                        local t =
                                                            (
                                                                position - 0.8
                                                            ) / 0.2

                                                        r = math.floor(
                                                            255 * t
                                                        )
                                                        g = 0
                                                        b = 255

                                                    end

                                                else

                                                    local position =
                                                        (
                                                            baseHue
                                                            + letterIndex * 0.08
                                                        ) % 1

                                                    r = math.floor(
                                                        255 * position
                                                    )

                                                    g = math.floor(
                                                        120 + 135 *
                                                        (1 - position)
                                                    )

                                                    b = 255

                                                end

                                                table.insert(
                                                    result,
                                                    string.format(
                                                        "#c%02x%02x%02x%s",
                                                        r,
                                                        g,
                                                        b,
                                                        character
                                                    )
                                                )

