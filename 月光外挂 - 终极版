UI.Terminal = nil
UI.TerminalInput = nil
UI.TerminalInputView = nil
UI.TerminalHistory = {}
UI.TerminalVisible = false
UI.TerminalOutput = nil

local TERMINAL_GREEN = { r = 0.10, g = 1.00, b = 0.28, a = 1.0 }
local TERMINAL_DARK  = { r = 0.005, g = 0.012, b = 0.008, a = 1.0 }
local TERMINAL_BORDER = { r = 0.05, g = 0.75, b = 0.20, a = 1.0 }

-- Only explicitly registered commands can run. No arbitrary Lua execution.
local TerminalCommands = {
    dffz = function() dffz() end,
    qkwjbb = function() qkwjbb() end,
    zdzl = function() zdzl() end,
    gbtq1 = function() gbtq1() end,
    gbtq2 = function() gbtq2() end,
    gbtq3 = function() gbtq3() end,
    gbtq4 = function() gbtq4() end,
    dtzl = function() dtzl() end,
    jzgj = function() jzgj() end,
    fzbr = function() fzbr() end,
    ycbr = function() ycbr() end,
    fzbk = function() fzbk() end,
    czbbd = function() czbbd() end,
    djdz = function() djdz() end,
    hdqp = function() hdqp() end,
    zstx = function() zstx() end,
    fjhmd = function() fjhmd() end,
    help = function()
        UI:TerminalWrite("COMMANDS: help, clear, dffz, qkwjbb, zdzl, gbtq1-4, dtzl, jzgj, fzbr, ycbr, fzbk, czbbd, djdz, hdqp, zstx, fjhmd")
    end,
    clear = function()
        UI.TerminalHistory = {}
        UI:TerminalRefresh()
    end
}

function UI:TerminalWrite(line)
    table.insert(self.TerminalHistory, tostring(line or ""))
    while #self.TerminalHistory > 13 do
        table.remove(self.TerminalHistory, 1)
    end
    self:TerminalRefresh()
end

function UI:TerminalRefresh()
    if self.TerminalOutput and not tolua.isnull(self.TerminalOutput) then
        self.TerminalOutput:setText(table.concat(self.TerminalHistory, "\n"))
    end
end

function UI:TerminalReadInput()
    local input = self.TerminalInput
    if not input then return nil end
    local ok, value = pcall(function() return input:getText() end)
    if ok and type(value) == "string" then return value end
    local view = self.TerminalInputView
    if view then
        ok, value = pcall(function() return view:getText() end)
        if ok and type(value) == "string" then return value end
    end
    return nil
end

function UI:TerminalClearInput()
    if self.TerminalInput then
        pcall(function() self.TerminalInput:setText("") end)
    end
    if self.TerminalInputView then
        pcall(function() self.TerminalInputView:setText("") end)
    end
end

function UI:TerminalExecute(command)
    command = tostring(command or "")
    command = command:match("^%s*(.-)%s*$") or ""
    if command == "" then return end

    self:TerminalWrite("> " .. command)
    local fn = TerminalCommands[string.lower(command)]
    if not fn then
        self:TerminalWrite("ERROR: unknown command: " .. command)
        return
    end

    local ok, err = pcall(fn)
    if ok then
        self:TerminalWrite("[OK] command completed")
    else
        self:TerminalWrite("[ERROR] " .. tostring(err))
    end
    self:TerminalClearInput()
end

