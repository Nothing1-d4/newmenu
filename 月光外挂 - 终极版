function tjsw()
    is_tjsw_active = not is_tjsw_active
    if not is_tjsw_active then
        ShowGameTipsWithoutFilter("#cff5555[Thần uy] ĐÃ TẮT")
        return
    end
    ShowGameTipsWithoutFilter("#c00ff00[Thần uy] ĐÃ BẬT (Tạo vòng sét quanh người)")
    threadpool:work(function()
        while is_tjsw_active do
            if not ClientCurGame or not ClientCurGame:isInGame() then
                is_tjsw_active = false
                break
            end
            if CurMainPlayer then
                local x, y, z = CurMainPlayer:getPosition(0, 0, 0)
                local center_x = x / 100
                local center_y = y / 100
                local center_z = z / 100

                local a_rad = 6.0
                local b_rad = 4.0
                local points = 7

                for i = 0, points - 1 do
                    local angle = (i / points) * math.pi * 2
                    local offset_x = math.cos(angle) * a_rad
                    local offset_z = math.sin(angle) * b_rad
                    local new_x = center_x + offset_x
                    local new_y = center_y
                    local new_z = center_z + offset_z

                    pcall(function()
                        CurWorld:playSoundAndParticleEffect(
                            new_x, new_y, new_z, 0, 0, 0, 0, 
                            new_x, new_y, new_z, 
                            'particles/aotu_06_leishenzhichui.ent', 1, 20
                        )
                    end)
                end
            end
            threadpool:wait(1.5)
        end
    end)
end

