                    _G.shenZhiTianShi_generation + 1

                ShowGameTipsWithoutFilter(
                    "已关闭"
                )

            elseif btnType == 1 then

                _G.shenZhiTianShi_enabled = true
                _G.shenZhiTianShi_generation =
                    _G.shenZhiTianShi_generation + 1

                local generation =
                    _G.shenZhiTianShi_generation

                threadpool:work(function()

                    if not ClientCurGame
                    or not ClientCurGame:isInGame() then

                        ShowGameTipsWithoutFilter(
                            "Hãy vào phòng trước"
                        )

                        _G.shenZhiTianShi_enabled = false
                        return
                    end

                    local uin = AccountManager:getUin()

                    if not uin then

                        ShowGameTipsWithoutFilter(
                            "Không lấy được UIN người chơi"
                        )

                        _G.shenZhiTianShi_enabled = false
                        return
                    end

                    local function hsvToRgb(h, s, v)

                        local i = math.floor(h * 6)
                        local f = h * 6 - i
                        local p = v * (1 - s)
                        local q = v * (1 - f * s)
                        local t = v * (1 - (1 - f) * s)

                        i = i % 6

                        if i == 0 then
                            return v, t, p
                        elseif i == 1 then
                            return q, v, p
                        elseif i == 2 then
                            return p, v, t
                        elseif i == 3 then
                            return p, q, v
                        elseif i == 4 then
                            return t, p, v
                        else
                            return v, p, q
                        end
                    end

                    local function rgbToHex(r, g, b)

                        return string.format(
                            "#c%02x%02x%02x",
                            math.floor(r * 255 + 0.5),
                            math.floor(g * 255 + 0.5),
                            math.floor(b * 255 + 0.5)
                        )
                    end

                    local function splitUtf8(text)

                        local chars = {}

                        for character in string.gmatch(
                            text,
                            "[%z\1-\127\194-\244][\128-\191]*"
                        ) do
                            table.insert(chars, character)
                        end

                        return chars
                    end

                    local title = "（神之）天使"
                    local characters = splitUtf8(title)

                    local offset = 0

                    while _G.shenZhiTianShi_enabled
                    and generation == _G.shenZhiTianShi_generation do

                        local result = {}

                        for i, character in ipairs(characters) do

                            local wave =
                                math.sin(
                                    offset + (i - 1) * 0.55
                                )

                            local hue =
                                0.91
