-- =========================================================================
local function CheckRightShiftDown()
    if CommonUtil and CommonUtil.GetAsyncKeyState then
        local ok, down = pcall(function() return CommonUtil:GetAsyncKeyState(161) end)
        if ok and down then return true end
    end
    if CurMainPlayer and CurMainPlayer.getPCControl then
        local ok, pcCtrl = pcall(function() return CurMainPlayer:getPCControl() end)
        if ok and pcCtrl and pcCtrl.GetKey then
            local ok2, down = pcall(function() return pcCtrl:GetKey(161) end)
            if ok2 and down then return true end
        end
    end
    if GetInst then
        local okInst, ugc = pcall(function() return GetInst("UGCCommon") end)
        if okInst and ugc and ugc.GetKeyCodeDown then
            local ok, down = pcall(function() return ugc:GetKeyCodeDown(161) end)
            if ok and down then return true end
        end
    end
    return false
end

threadpool:work(function()
    local lastState = false
    while _G.MoonUI_SessionId == currentSessionId do
        threadpool:wait(0.04)
        local isDown = CheckRightShiftDown()
        if isDown and not lastState then
            lastState = true
            UI:ToggleTerminal()
        elseif not isDown then
            lastState = false
        end
    end
end)

threadpool:work(function()
    threadpool:wait(0.2)
    if _G.MoonUI_SessionId == currentSessionId then
        UI:Init()
    end
end)


