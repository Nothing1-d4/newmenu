function fosgm()

    GetInst("MessageBoxInterface"):dualBtnBox(
        "Start or stop this?",
        "FOSGM - Final Overstrike: God Mode",
        nil,
        function(userData, btnType)

            if btnType == 0 then
                _G.fosgm_enabled = false
                _G.fosgm_started = false
                ShowGameTipsWithoutFilter("#cFF0000FOSGM STOPPED")

            elseif btnType == 1 then

                if _G.fosgm_enabled then
                    return
                end

                _G.fosgm_enabled = true
                _G.fosgm_started = true

                ShowGameTipsWithoutFilter(
                    "#b#RAPOCALYPSE HAS STARTED !!!"
                )

                local skyboxIds = {
                    30005, 30006, 30007, 30008,
                    30009, 30010, 30011, 30012
                }

                -- SKYBOX: START SLOW, GRADUALLY ACCELERATE
                threadpool:work(function()

                    local index = 1
                    local delay = 0.5
                    local minimumDelay = 0.07
                    local acceleration = 0.005

                    while _G.fosgm_enabled do

                        local tdata = {
                            [1] = "world",
                            [2] = "SetSkyBoxMaps",
                            [3] = {
                                1,
                                skyboxIds[index],
                                ""
                            }
                        }

                        ScriptSupportTask:reportTaskToHost(
                            SSTASKID.HOST_BordCast,
                            tdata
                        )

                        index = index + 1

                        if index > #skyboxIds then
                            index = 1
                        end

                        threadpool:wait(delay)

                        delay = math.max(
                            minimumDelay,
                            delay - acceleration
                        )
                    end
                end)

                -- RAINBOW TIMER: GENERATE ONCE, BROADCAST ONCE
                threadpool:work(function()

                    threadpool:wait(10)

                    if not _G.fosgm_enabled then
                        return
                    end

                    local text = "APOCALYPSE HAS STARTED!"
                    local characters = {}
                    local result = {}
                    local letterIndex = 0

                    for character in string.gmatch(
                        text,
                        "[%z\1-\127\194-\244][\128-\191]*"
                    ) do
                        table.insert(characters, character)
                    end

                    for _, character in ipairs(characters) do

                        if character == " " or character == "\n" then
                            table.insert(result, character)

                        else
                            local hue = (letterIndex * 0.08) % 1
                            local sector = math.floor(hue * 6)
                            local fraction = hue * 6 - sector

                            local q = 1 - fraction
                            local t = fraction

                            sector = sector % 6

                            local red, green, blue

                            if sector == 0 then
                                red, green, blue = 1, t, 0
                            elseif sector == 1 then
                                red, green, blue = q, 1, 0
                            elseif sector == 2 then
                                red, green, blue = 0, 1, t
                            elseif sector == 3 then
                                red, green, blue = 0, q, 1
                            elseif sector == 4 then
                                red, green, blue = t, 0, 1
                            else
                                red, green, blue = 1, 0, q
                            end

                            red = math.floor(red * 255 + 0.5)
                            green = math.floor(green * 255 + 0.5)
                            blue = math.floor(blue * 255 + 0.5)

                            table.insert(
                                result,
                                string.format(
                                    "#c%02X%02X%02X%s",
                                    red,
                                    green,
                                    blue,
                                    character
                                )
                            )

                            letterIndex = letterIndex + 1
                        end
                    end

                    local rainbowText = table.concat(result)

                    local createTimerData = {
                        [1] = "minitimer2",
                        [2] = "createTimer",
                        [3] = {""}
                    }

                    ScriptSupportTask:reportTaskToHost(
                        SSTASKID.HOST_BordCast,
                        createTimerData
                    )

                    local showTimerData = {
                        [1] = "minitimer2",
                        [2] = "showTimerTips",
                        [3] = {
                            {0},
                            1,
                            rainbowText,
                            true
                        }
                    }

                    ScriptSupportTask:reportTaskToHost(
                        SSTASKID.HOST_BordCast,
                        showTimerData
                    )
                end)

                -- FOG EFFECT AND EXISTING FUNCTION
                threadpool:work(function()

                    threadpool:wait(15)

                    if not _G.fosgm_enabled then
                        return
                    end

                    local fogTdata = {
                        [1] = "actor",
                        [2] = "playBodyEffectByFile",
                        [3] = {
                            AccountManager:getUin(),
                            "fog",
