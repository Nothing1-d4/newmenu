                                                            (
                                                                position - 0.2
                                                            ) / 0.2

                                                        r = 255
                                                        g = math.floor(
                                                            255 * t
                                                        )
                                                        b = math.floor(
                                                            255 - 255 * t
                                                        )

                                                    elseif position < 0.6 then

                                                        local t =
                                                            (
                                                                position - 0.4
                                                            ) / 0.2

                                                        r = math.floor(
