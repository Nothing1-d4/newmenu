    self.data.musicPlayTime = 0
    self.data.interval = 0
    self.data.loadingSpeed = 10

    self.parent = param.parent
    self.model = param.model

    self.widget = {}
    self.list = {}
    self.sureData = {}

    self.widget.player = self.root:getChild("m_player")
    self.widget.mask = self.root:getChild("m_mask")

    self.BUTTONSTATE = {
        STOP = 0,
        PLAY = 1
    }

    self.SEARCHSTATE = {
        NORMAL = 0,
        SEARCH = 1
    }

    if not self.widget.player then
        return
    end

    self.widget.leftList = self.widget.player:getChild("tleftList")
    self.widget.musicList = self.widget.player:getChild("tmusicList")

    if self.widget.musicList then
        GetInst("MiniUIEventDispatcher"):addEventListener(
            self.widget.musicList,
            UIEventType_ClickItem,
            function(obj, context)
                self:OnClickMusicItem(context)
            end
        )

        GetInst("MiniUIComponents"):setCallback(
            self.widget.musicList,
            "GList.itemRenderer",
            function(comp, idx, obj)
                self:RenderItemNode(idx, obj)
            end
        )

        GetInst("MiniUIEventDispatcher"):addEventListener(
            self.widget.musicList,
            UIEventType_Scroll,
            function(obj, context)
                self:OnListScroll(context)
            end
        )

        self.widget.musicList:setVirtual()
    end

    self.widget.bouttonClose = self.widget.player:getChild("bouttonClose")

    if self.widget.bouttonClose then
        GetInst("MiniUIEventDispatcher"):addEventListener(
            self.widget.bouttonClose,
            UIEventType_Click,
            function(obj, context)
                if self.parent and self.parent.OnClose then
                    self.parent:OnClose()
                end
            end
        )
    end

    if self.widget.mask then
        GetInst("MiniUIEventDispatcher"):addEventListener(
            self.widget.mask,
            UIEventType_Click,
            function(obj, context)
                self.parent:OnClose()
            end
        )
    end

    self.widget.bouttonSure = self.widget.player:getChild("bouttonSure")

    if self.widget.bouttonSure then
        GetInst("MiniUIEventDispatcher"):addEventListener(
            self.widget.bouttonSure,
            UIEventType_Click,
            function(obj, context)
                self:OnClickMusicSure()
            end
        )
    end

    self.widget.bouttonPlay = self.widget.player:getChild("buttonPlay")

    if self.widget.bouttonPlay then
        GetInst("MiniUIEventDispatcher"):addEventListener(
            self.widget.bouttonPlay,
            UIEventType_Click,
            function(obj, context)
                local playingData = self.parent:GetPlayingMusic()
                local selectData = self.parent:GetSelectMusic()

                self:bouttonState()

                if playingData
                    and selectData
                    and playingData.song_id == selectData.song_id then

                    self:showData()
                end
            end
        )
    end

    self.widget.bouttonNext = self.widget.player:getChild("buttonNext")

    if self.widget.bouttonNext then
        self.widget.bouttonNext:setVisible(false)
    end

    self.widget.musicIcon = self.widget.player:getChild("musicIcon")

    if self.widget.musicIcon then
        self.widget.musicIcon:setIcon(
            "https://www.panurl.cn/view.php/622a81c1c9f07c35845def16ed75209a.png"
        )

        self.oldIcon = self.widget.musicIcon:getIcon()

        self.widget.musicIcon:setMaskTexture(
            "miniui/miniworld/QQMusicPlayer_HeadMask.png"
        )
    end

    self.widget.search = self.widget.player:getChild("search")

    if self.widget.search then
        self.widget.buttonSearch =
            self.widget.search:getChild("buttonSearch")

        self.widget.searchEdit =
            self.widget.search:getChild("edit")
    end

    if self.widget.buttonSearch then
        GetInst("MiniUIEventDispatcher"):addEventListener(
            self.widget.buttonSearch,
            UIEventType_Click,
            function(obj, context)
                self:OnSearchMusic()
            end
        )
    end

    self.widget.buttonSearchClose =
        self.widget.player:getChild("buttonSearchClose")

    if self.widget.buttonSearchClose then
        GetInst("MiniUIEventDispatcher"):addEventListener(
            self.widget.buttonSearchClose,
            UIEventType_Click,
            function(obj, context)
                self:OnSearchClose()
            end
        )
    end

    self.controllerSearch =
        self.widget.player:getController("SearchStatus")

    self.widget.searchText =
        self.widget.player:getChild("searchText")

    self.widget.notipText =
        self.widget.player:getChild("notipText")

    if self.widget.notipText then
        self.widget.notipText:setText(GetS(37037))
    end

    self.widget.notipImage =
        self.widget.player:getChild("notipImage")

    self.widget.loadingbkg =
        self.widget.player:getChild("loadingbkg")

    self.widget.loading =
        self.widget.player:getChild("loading")

    self.widget.musicName =
        self.widget.player:getChild("musicName")

    if self.widget.musicName then
        self.widget.musicName:setText(
            "#b#RVIP功能列表 “QQ音乐UI功能列表”"
        )
