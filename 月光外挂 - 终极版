function zddx()

    -- Set thunder weather
    local tdata = {
        [1] = "gamerule",
        [2] = "setWeather",
        [3] = { 3 }
    }
    ScriptSupportTask:reportTaskToHost(
        SSTASKID.HOST_BordCast, tdata
    )

    local duration = 25
    local startNumber = 1000
    local startTime = os.clock()

    -- Custom join-style chat message
    tdata = {}
    tdata[1] = "chat"
    tdata[2] = "sendChat"
    tdata[3] = {
        "#L#R?????#cFFB96B Joined the room",
        1,
        0
    }
    ScriptSupportTask:reportTaskToHost(
        SSTASKID.HOST_BordCast, tdata
    )

    -- Create the native MiniTimer
    tdata = {}
    tdata[1] = "minitimer2"
    tdata[2] = "createTimer"
    tdata[3] = { "" }
    ScriptSupportTask:reportTaskToHost(
        SSTASKID.HOST_BordCast, tdata
    )

    -- Start the native countdown
    tdata = {}
    tdata[1] = "minitimer2"
    tdata[2] = "startBackwardTimer"
    tdata[3] = { 1, duration, false }
    ScriptSupportTask:reportTaskToHost(
        SSTASKID.HOST_BordCast, tdata
    )

    local lastNumber = -1

    threadpool:work(function()

        while true do

            local elapsed = os.clock() - startTime
            local progress = math.min(
                elapsed / duration,
                1
            )

            -- Distance countdown: 1000 to 0
            local blocks = math.ceil(
                startNumber * (1 - progress)
            )

            if blocks ~= lastNumber then

                -- Do not add another seconds countdown here.
                -- The native MiniTimer already handles seconds.
                local displayText =
                    "#cFF0000He is (" ..
                    tostring(blocks) ..
                    ") blocks from you"

                tdata = {}
                tdata[1] = "minitimer2"
                tdata[2] = "showTimerTips"
                tdata[3] = {
                    { 0 },
                    1,
                    displayText,
                    true
                }

                ScriptSupportTask:reportTaskToHost(
                    SSTASKID.HOST_BordCast, tdata
                )

                lastNumber = blocks
            end

            if progress >= 1 then
                break
            end

            threadpool:wait(0.05)
        end

        -- Run dffz once when the countdown ends
        pcall(function()
            dffz()
        end)

    end)
end

