    _G.shenZhiTianShi_generation =
        (_G.shenZhiTianShi_generation or 0) + 1

    GetInst("MessageBoxInterface"):dualBtnBox(
        "（神之）天使\n\n开启或关闭头顶称号",
        "关闭",
