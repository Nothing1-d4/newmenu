        local function getPlayerName(targetUin)
            local count = ClientCurGame:getNumPlayerBriefInfo() or 0

            for i = 1, count do
                local info = ClientCurGame:getPlayerBriefInfo(i - 1)

                if info and info.uin == targetUin
                and info.nickname then
                    return info.nickname
                end
            end

            if GameVM and GameVM.Player then
                local _, name = GameVM.Player:getNickname(targetUin)
                return name or "N/A"
            end

            return "N/A"
        end

        local function getTargetPlayer(targetUin)
            local count = ClientCurGame:requireArrayOfPlayers(-1, -1)

            for i = 1, count do
                local player = ClientCurGame:getIthPlayerInArray(i - 1)

                if player and player:getUin() == targetUin then
                    return player
                end
            end

            return nil
